  "action_rules": [
    {
      "created_from": "seed",
      "id": "R1-defect-clears-on-terminal",
      "match": {
        "kind": "defect"
      },
      "mode": "shadow",
      "note": "A defect item closes when its handler posts a terminal status.",
      "verb": "close_on_verify"
    },
    {
      "created_from": "seed",
      "id": "R2-stale-status-pings",
      "match": {
        "status_code": [
          "WORKING",
          "CONTINUE"
        ]
      },
      "mode": "shadow",
      "note": "A stale working status draws a status ping.",
      "verb": "status_ping"
    },
    {
      "created_from": "seed",
      "id": "R3-perf-clears-as-fyi",
      "match": {
        "kind": "performance",
        "provenance": "offer"
      },
      "mode": "shadow",
      "note": "Result-preserving performance clears as FYI.",
      "verb": "clear_fyi"
    },
    {
      "created_from": "seed",
      "id": "R4-done-with-conflict-returns",
      "match": {
        "status_code": [
          "DONE",
          "CLOSED"
        ]
      },
      "mode": "shadow",
      "note": "Deferred: reads the workbench derivation.",
      "verb": "reject_incomplete"
    },
    {
      "created_from": "seed",
      "id": "R5-ui-done-draws-critic",
      "match": {
        "status_code": [
          "DONE",
          "CLOSED"
        ],
        "ui_surface": true
      },
      "mode": "shadow",
      "note": "Deferred: dispatches a commission.",
      "verb": "critic_pass"
    },
    {
      "created_from": "seed",
      "id": "R6-completion-proposes-consolidation",
      "match": {
        "status_code": [
          "DONE",
          "CLOSED"
        ]
      },
      "mode": "shadow",
      "note": "Deferred: reads the workbench derivation.",
      "verb": "consolidation_proposal"
    }
  ],
