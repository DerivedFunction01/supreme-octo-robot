# Template — render before installing: the freeze render
# substitutes @ROOT@ (the mega repo root), @PYTHON@ and
# @HOME@ for the host. The rendered unit is a
# machine-local artefact, never tracked.
#
# The workbench's own unit (owner ruling, 2026-11-15:
# process boundaries follow coupling). The workbench
# serves alone — the repo-root run.py serve-workbench,
# the work-record server's own mount on 8792 — because
# its feeds assembly saturation must not be able to
# starve the coupled surfaces' health (the D-9 kill
# loop: the assembly in the one process starved every
# surface's health until the watchdog killed the unit).
# Its own process, its own unit, its own health verdict;
# the coupled surfaces (scheduler, attention) serve
# under workhorse.service and the lease panel under
# venue.service, and no probe or shim joins the
# processes. A worker fault exits
# this process non-zero, so the Restart below is the
# supervision: the process comes back loudly rather
# than serving with a dead loop.
#
# This unit carries no ATTENTION_DATA: the workbench
# binds no attention store. Its config is its own seam
# (WB_VIEWER_* env > its config.json > defaults).
[Unit]
Description=Workbench (workhorse superapp — its own process: the workbench surface only)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/workhorse.env
Environment=HOME=@HOME@
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@PYTHON@ @ROOT@/run.py serve-workbench
Restart=always
RestartSec=2
# MemoryMax (Workbench lane's SIGKILL diagnosis,
# 2026-11-16): the cadence kills were the kernel OOM
# killer taking the box's largest process when two
# generations of the feeds document coexisted (~4.82 GB
# HWM). The per-repo eager-payload budget (be635ca)
# brings the cured two-generation peak to ~1–1.5 GB;
# 3G clears that peak with 2x headroom for document
# growth while still catching the ~5 GB class, and
# converts any recurrence from a silent kernel kill
# into an attributable cgroup oom-kill (systemd reports
# the unit's result as 'oom-kill'), which is the
# diagnosability this VM otherwise denies (no kernel
# log, no cgroup memory.events in the service's mount
# namespace).
MemoryMax=3G
StandardOutput=append:@ROOT@/pipeline/platform/var/workbench.log
StandardError=append:@ROOT@/pipeline/platform/var/workbench.log

[Install]
WantedBy=default.target
