# Copy to .env, chmod 600 .env, never commit .env.
# Generate at https://login.tailscale.com/admin/settings/keys
# Reusable, non-ephemeral (persistent home machine), pre-approved if offered.
TS_AUTHKEY=
# Example resource caps for the workspace container. The actual
# allocation for a specific host is instance state, recorded in the
# untracked instance/ folder — not here.
COMPUTE_MEM=8g
COMPUTE_CPUS=4
