#!/usr/bin/env python3
"""Thin CLI over the standing bridge (plan: .plans/2026-11-01-lobby-bridge.md).

Usage: colab-bridge status|children|log [--tail N]|ping [--wait S]|cmd [--target T] [--timeout S] [--wait S] <shell...>|mint <shape> [--name N] [--wait S]|stop <name> [--wait S]

The client plants a signed command file into the bridge queue in
the standing lease and waits (bounded) for its terminal line in the
bridge log. Exit codes: for `cmd`, the command's own rc when a
result arrived; 2 for bridge-level failures (no standing lease, plant
failed, wait timed out — the command may still land later; `log`
and the local mirror keep it). File-only drivers skip this client
entirely: drop a signed command into var/bridge-outbox/ and read
var/bridge-mirror.jsonl — the ferry (in the reaper's standing pass)
moves both.
"""

import importlib.util
import json
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _load

REPO = _load.REPO

spec = importlib.util.spec_from_loader("venue_run", SourceFileLoader("venue_run", str(REPO / "bin" / "venue-run")))
cr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(cr)

spec_l = importlib.util.spec_from_file_location(
    "lease", REPO / "sync" / "lease" / "__init__.py",
    submodule_search_locations=[str(REPO / "sync" / "lease")])
lease = importlib.util.module_from_spec(spec_l)
sys.modules["lease"] = lease
spec_l.loader.exec_module(lease)

argv_mod = _load.platform_argv()

# The verb surface, declared once for the unified argument
# parser (pipeline/platform/argv.py): help is generated
# from this declaration, and anything outside it — an
# unknown flag, a surplus positional, a value flag with
# no value — is a usage refusal at exit 2.
_WAIT = {"wait": {"takes_value": True, "help": "seconds to wait for the terminal line"}}
DECL = {
    "name": "colab-bridge",
    "summary": "Thin CLI over the standing bridge: plant a signed command file into the bridge queue and wait (bounded) for its terminal line.",
    "verbs": {
        "status": {},
        "children": {},
        "log": {"flags": {"tail": {"takes_value": True, "help": "log lines to print (default 50)"}}},
        "ping": {"flags": dict(_WAIT)},
        "cmd": {
            "flags": {
                "target": {"takes_value": True, "help": "bridge target (default: self)"},
                "timeout": {"takes_value": True, "help": "the command's timeout in seconds"},
                **_WAIT,
            },
            "positionals": [{"name": "shell", "variadic": True}],
        },
        "mint": {
            "flags": {
                "name": {"takes_value": True, "help": "child session name"},
                **_WAIT,
            },
            "positionals": [{"name": "shape", "required": True}],
        },
        "stop": {
            "flags": dict(_WAIT),
            "positionals": [{"name": "name", "required": True}],
        },
    },
}


def _num(flags: dict, name: str) -> tuple[float | None, str | None]:
    """A numeric flag's value as a float, with the standing
    message. Returns (value, error)."""
    raw = flags.get(name)
    if raw is None:
        return None, None
    try:
        return float(raw), None
    except ValueError:
        return None, f"--{name} needs a number"


TERMINAL = ("result", "mint", "stop", "pong", "error", "duplicate")


def standing_session() -> tuple[str | None, str | None]:
    rec = lease.standing_record(REPO)
    if not rec:
        return None, lease.standing_shape(REPO)
    return rec["session"], lease.standing_shape(REPO)


def plant(session: str, cmd: dict) -> bool:
    var = lease.var_dir(REPO)
    var.mkdir(parents=True, exist_ok=True)
    local = var / f"bridge-cmd-{cmd['id']}.json"
    local.write_text(json.dumps(cmd))
    try:
        r = cr.colab("upload", "-s", session, str(local), f"{lease.BRIDGE_REMOTE}/queue/{cmd['id']}.json", timeout=30)
        return r.returncode == 0
    except Exception:  # noqa: BLE001
        return False
    finally:
        local.unlink(missing_ok=True)


def scan_log(session: str, cid: str) -> dict | None:
    status = lease.bridge_status_read(cr.colab, REPO, session)
    if status is None:
        return None
    segment = status.get("log_segment") or "bridge-000001.jsonl"
    dest = lease.var_dir(REPO) / "bridge-client-dl.jsonl"
    try:
        r = cr.colab("download", "-s", session, f"{lease.BRIDGE_REMOTE}/log/{segment}", str(dest), timeout=30)
        if r.returncode != 0 or not dest.exists():
            return None
        found = None
        for raw in dest.read_text(errors="replace").splitlines():
            try:
                line = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if isinstance(line, dict) and line.get("id") == cid and line.get("kind") in TERMINAL:
                found = line
        return found
    except Exception:  # noqa: BLE001
        return None


def plant_and_wait(session: str, cmd: dict, wait_s: float) -> dict:
    if not plant(session, cmd):
        return {"bridge": "plant-failed", "id": cmd["id"]}
    deadline = time.monotonic() + wait_s
    while time.monotonic() < deadline:
        line = scan_log(session, cmd["id"])
        if line is not None:
            return line
        time.sleep(3)
    return {"bridge": "wait-timeout", "id": cmd["id"]}


def main() -> int:
    try:
        parsed = argv_mod.parse(DECL, sys.argv[1:])
    except argv_mod.UsageError as exc:
        print(str(exc), file=sys.stderr)
        print(argv_mod.help_text(DECL), file=sys.stderr)
        return 2
    if "help" in parsed:
        print(parsed["help"])
        return 0
    cmd = parsed["verb"]
    flags = parsed["flags"]
    pos = parsed["positionals"]
    session, _shape = standing_session()

    if cmd == "status":
        block = lease._bridge_block(cr.colab, REPO)
        print(json.dumps({"bridge": block}, indent=1))
        return 0 if block else 1

    if cmd == "log":
        tail_f, err = _num(flags, "tail")
        if err:
            print(f"colab-bridge: {err}", file=sys.stderr)
            return 2
        tail = int(tail_f) if tail_f is not None else 50
        lines: list[str] = []
        if session:
            status = lease.bridge_status_read(cr.colab, REPO, session)
            if status is not None:
                last = 1
                try:
                    last = int(str(status.get("log_segment"))[7:13])
                except (TypeError, ValueError):
                    pass
                dest = lease.var_dir(REPO) / "bridge-client-dl.jsonl"
                for n in range(1, last + 1):
                    try:
                        r = cr.colab("download", "-s", session, f"{lease.BRIDGE_REMOTE}/log/bridge-{n:06d}.jsonl", str(dest), timeout=30)
                        if r.returncode == 0 and dest.exists():
                            lines.extend(dest.read_text(errors="replace").splitlines())
                    except Exception:  # noqa: BLE001
                        break
        if not lines:
            mirror = lease.var_dir(REPO) / "bridge-mirror.jsonl"
            if mirror.exists():
                lines = mirror.read_text(errors="replace").splitlines()
        for raw in lines[-tail:]:
            print(raw)
        return 0

    if session is None:
        print(json.dumps({"bridge": "no-standing"}))
        return 2

    if cmd == "children":
        block = lease._bridge_block(cr.colab, REPO) or {}
        print(json.dumps({"children": block.get("children", [])}, indent=1))
        return 0

    if cmd == "ping":
        wait_s, err = _num(flags, "wait")
        if err:
            print(f"colab-bridge: {err}", file=sys.stderr)
            return 2
        line = plant_and_wait(session, lease.bridge_command("ping"), wait_s if wait_s is not None else 60.0)
        print(json.dumps(line, indent=1))
        return 0 if line.get("kind") == "pong" else 2

    if cmd == "cmd":
        timeout_s, err = _num(flags, "timeout")
        wait_s = None
        if err is None:
            wait_s, err = _num(flags, "wait")
        out = pos["shell"]
        if err or not out:
            print(f"colab-bridge: {err or 'cmd needs a shell command'}", file=sys.stderr)
            return 2
        fields = {"target": flags.get("target") or "self", "cmd": " ".join(out)}
        if timeout_s:
            fields["timeout_s"] = timeout_s
        line = plant_and_wait(session, lease.bridge_command("run", **fields), wait_s if wait_s is not None else 180.0)
        print(json.dumps(line, indent=1))
        if line.get("kind") == "result":
            return int(line["rc"]) if isinstance(line.get("rc"), int) else 1
        return 2

    if cmd == "mint":
        wait_s, err = _num(flags, "wait")
        if err:
            print(f"colab-bridge: {err}", file=sys.stderr)
            return 2
        fields = {"shape": pos["shape"]}
        if flags.get("name"):
            fields["name"] = flags["name"]
        line = plant_and_wait(session, lease.bridge_command("mint", **fields), wait_s if wait_s is not None else 300.0)
        print(json.dumps(line, indent=1))
        return 0 if line.get("kind") == "mint" else 2

    if cmd == "stop":
        wait_s, err = _num(flags, "wait")
        if err:
            print(f"colab-bridge: {err}", file=sys.stderr)
            return 2
        line = plant_and_wait(session, lease.bridge_command("stop", name=pos["name"]), wait_s if wait_s is not None else 180.0)
        print(json.dumps(line, indent=1))
        return 0 if line.get("kind") == "stop" else 2

    print(__doc__)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
