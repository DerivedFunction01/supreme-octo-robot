#!/usr/bin/env python3
"""Thin CLI over sync/lease/ — the shared-session lease.

Usage: colab-lease status [session]|acquire --shape ID [--hours H] [--via TAG] [--caller TAG] [--create] [--venue V]|extend SESSION --hours H [--caller TAG]|adopt (SESSION|--endpoint EP) [--deadline ISO|--hours H] [--caller TAG] [--shape ID]|shorten SESSION (--deadline ISO|--hours H) [--caller TAG]|claim-sync SESSION [--caller TAG]|release-sync SESSION [--caller TAG]|release [session]|release-session (SESSION|--endpoint EP)|reap [--gate-pending-hosts CSV] [--gate-probe-hosts CSV]|keepalive|auto|request [--shape ID] [--reason TEXT] [--caller TAG] [--at ISO-TIME]|unrequest|grant --hours H [--burst SHAPE]|extend-grant --hours H|ungrant|standing|state|budget-caps [--daily V] [--monthly V] [--standing-daily V] [--venue V] [--account V]|accounts|admission --shape ID [--via TAG] [--caller TAG]|plan --shape ID
Prints one JSON result. `reap` is the reaper-hook duty (deadline +
orphan reconciliation across all lease records); its gate flags
carry the hook's approval-gate scope — the tunnel hosts with no
proven contact, and the subset whose hourly probe is due — and
the pass scopes only the records on those hosts (a pending
record's one probe pulse aside, it is not dialed; every other
record gets full duties). A malformed host list refuses before
any lease work runs; no flags is the unscoped pass every other
caller gets. `auto` is the
hook's auto-acquire duty (inert unless enabled in config/lease.json);
`request` records a lease demand that `auto` consumes; `--at ISO-TIME`
makes it a timed start the duty fires when due — data, not an agent
job. `grant` opens
a two-tier window whose standing lease the `standing` duty keeps up; `extend`
moves a lease's deadline later (delta-priced, flags the lease as a
renewable window); `adopt` plants a record for a live session that
has none, from the deadline evidence its journals carry (the
`orphans` state portion lists them) — with `--endpoint` instead of
a name it adopts a live assignment that carries no usable name:
a fresh name is minted and bound to the endpoint, and the record
is restored from the endpoint's own evidence under that name;
`shorten` moves a deadline
earlier, the mirror of `extend`; and `extend-grant` moves the grant's end the same
way; `state` is the UI's single read (records + grant + specs +
budget). `budget-caps` updates the budget caps in config/lease.json
(the panel's editor rides it); each value is a non-negative number
or `none` for no cap, and an omitted flag leaves its cap untouched.
`--venue` / `--account` address one adapter's one account (venue
rework): the default target — this venue's primary account —
every write lands in the config's budgets block for that
(venue, account) — caps are tied per venue and account, and
there are no flat cap keys. `accounts` is the read-only census of the
venue's accounts: resolved caps, credential status, attributed
spend.
`admission` is the session shape
gate's verdict for one shape (the session-creating wrappers that
bypass the lease core consult it): prints admitted, or the
shape-refused verdict with exit 1. `plan` mints a generated session
name plus the CLI args for one shape without creating anything
(the session-creating wrappers ride it, so name generation and
shape flags live in exactly one place).
"""

import importlib.util
import json
import os
import sys
from datetime import datetime
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _load

REPO = _load.REPO

spec = importlib.util.spec_from_loader("venue_run", SourceFileLoader("venue_run", str(REPO / "bin" / "venue-run")))
cr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(cr)

spec_l = importlib.util.spec_from_file_location(
    "lease", REPO / "sync" / "lease" / "__init__.py",
    submodule_search_locations=[str(REPO / "sync" / "lease")])
lease = importlib.util.module_from_spec(spec_l)
sys.modules["lease"] = lease
spec_l.loader.exec_module(lease)

TOKEN = Path.home() / ".config" / "colab-cli" / "token.json"

argv_mod = _load.platform_argv()

_VALUE = {"takes_value": True}
_CALLER = {"caller": {"takes_value": True, "help": "caller tag"}}
_HOURS = {"hours": {"takes_value": True, "help": "hours (a number > 0)"}}
_SESSION = [{"name": "session", "required": True}]

# The verb surface, declared once for the unified argument
# parser (pipeline/platform/argv.py): every verb's flags and
# positionals live here, help is generated from this
# declaration, and anything outside it — an unknown flag, a
# surplus positional, a value flag with no value — is a usage
# refusal at exit 2. Repeated value flags are last-wins.
DECL = {
    "name": "colab-lease",
    "summary": "Thin CLI over sync/lease/ — the shared-session lease. Prints one JSON result.",
    "verbs": {
        "status": {"positionals": [{"name": "session"}]},
        "acquire": {
            "flags": {
                "shape": {"takes_value": True, "help": "shape id"},
                "hours": _HOURS["hours"],
                "via": {"takes_value": True, "help": "via tag"},
                "caller": _CALLER["caller"],
                "create": {"help": "create the session when none is free"},
                "venue": {"takes_value": True, "help": "venue adapter id"},
            },
            "positionals": [{"name": "shape"}],
        },
        "extend": {"flags": {**_HOURS, **_CALLER}, "positionals": _SESSION},
        "adopt": {
            "flags": {
                "endpoint": {"takes_value": True, "help": "endpoint of a nameless live assignment"},
                "deadline": {"takes_value": True, "help": "ISO deadline"},
                "shape": {"takes_value": True, "help": "shape id"},
                **_HOURS,
                **_CALLER,
            },
            "positionals": [{"name": "session"}],
        },
        "shorten": {
            "flags": {
                "deadline": {"takes_value": True, "help": "ISO deadline"},
                **_HOURS,
                **_CALLER,
            },
            "positionals": _SESSION,
        },
        "claim-sync": {"flags": dict(_CALLER), "positionals": _SESSION},
        "release-sync": {"flags": dict(_CALLER), "positionals": _SESSION},
        "release": {"positionals": [{"name": "session"}]},
        "release-session": {
            "flags": {"endpoint": {"takes_value": True, "help": "endpoint of a nameless live assignment"}},
            "positionals": [{"name": "session"}],
        },
        "reap": {
            "flags": {
                "gate-pending-hosts": {"takes_value": True, "help": "CSV of approval-gate hosts with no proven contact"},
                "gate-probe-hosts": {"takes_value": True, "help": "CSV subset of the gate hosts whose hourly probe is due"},
            },
        },
        "keepalive": {},
        "auto": {},
        "request": {
            "flags": {
                "shape": {"takes_value": True, "help": "shape id"},
                "reason": {"takes_value": True, "help": "demand reason text"},
                "caller": _CALLER["caller"],
                "via": {"takes_value": True, "help": "legacy spelling of --caller"},
                "at": {"takes_value": True, "help": "ISO time for a timed start"},
            },
            "positionals": [{"name": "shape"}],
        },
        "unrequest": {},
        "grant": {
            "flags": {
                "burst": {"takes_value": True, "help": "burst shape id"},
                **_HOURS,
            },
        },
        "extend-grant": {"flags": dict(_HOURS)},
        "ungrant": {},
        "standing": {},
        "state": {
            "flags": {
                "part": {
                    "takes_value": True,
                    "choices": ["records", "specs", "budget", "grant", "meta", "orphans", "listeners"],
                    "help": "serve one portion of the state read",
                },
            },
        },
        "budget-caps": {
            "flags": {
                "daily": {"takes_value": True, "help": "daily cap (a number or 'none')"},
                "monthly": {"takes_value": True, "help": "monthly cap (a number or 'none')"},
                "standing-daily": {"takes_value": True, "help": "standing daily cap (a number or 'none')"},
                "venue": {"takes_value": True, "help": "venue adapter id"},
                "account": {"takes_value": True, "help": "account id"},
            },
        },
        "accounts": {},
        "admission": {
            "flags": {
                "shape": {"takes_value": True, "help": "shape id"},
                "via": {"takes_value": True, "help": "via tag"},
                "caller": _CALLER["caller"],
            },
            "positionals": [{"name": "shape"}],
        },
        "plan": {
            "flags": {"shape": {"takes_value": True, "help": "shape id"}},
            "positionals": [{"name": "shape"}],
        },
    },
}


def _hours(flags: dict, verb: str, required: bool = False) -> tuple[float | None, str | None]:
    """The --hours flag as a float, with the standing
    messages. Returns (hours, error): hours is None when the
    flag is absent and not required."""
    raw = flags.get("hours")
    if raw is None:
        if required:
            return None, f"{verb} requires --hours H (H > 0)"
        return None, None
    try:
        hours = float(raw)
    except ValueError:
        return None, "--hours needs a number"
    if hours <= 0:
        return None, "--hours must be > 0"
    return hours, None


def _shape(parsed: dict) -> str | None:
    """The shape a verb acts on: the --shape flag, else the
    positional of the same name."""
    return parsed["flags"].get("shape") or parsed["positionals"].get("shape")


def resolve_cli_caller(flag: str | None) -> tuple[str | None, str | None]:
    """Resolve a --caller flag against $COLAB_CALLER through the
    core's registry. Returns (caller, error): a presented but
    unregistered claim is an error — refused at claim time — while
    no claim at all is (None, None), an unattributed call."""
    env = os.environ.get("COLAB_CALLER")
    err = lease.caller_claim_error(REPO, flag=flag, env=env)
    if err:
        return None, err
    return lease.resolve_caller(REPO, flag=flag, env=env), None


# --- reap command composition -------------------------------------------------
# The reaper hook bounds the whole `colab-lease reap` command at
# 420 s, but the command composes two channel acts: the lease
# pass and the standing collector that rides it. 7739f5d budgeted
# the pass alone and the collector kept its own independent
# budget — 600 s of sanctioned work inside the bound, and cycles
# kept dying inside the collector (2026-11-14, hook invocations
# 0f5d985b and 12:11:44Z). The composition therefore runs
# against ONE command budget: the collector rides as a
# subprocess over the standalone --collect-stale verb, allotted
# whatever the pass did not spend, and the pass result is
# persisted to var/last-reap.json before the collector runs, so
# a death anywhere later in the command cannot eat the pass's
# budget report. A killed attendance is safe: poll_run saves as
# it goes, the attended record's collector stamp has advanced,
# and partial pulls resume next cycle.

_REAP_COMMAND_BUDGET_DEFAULT_S = 390.0
_COLLECT_MIN_REMAINING_S = 20.0


def _reap_command_budget_s() -> float:
    raw = os.environ.get("COLAB_LEASE_REAP_COMMAND_BUDGET_S")
    try:
        return float(raw) if raw else _REAP_COMMAND_BUDGET_DEFAULT_S
    except ValueError:
        return _REAP_COMMAND_BUDGET_DEFAULT_S


def _chain_log(event: dict) -> None:
    """One line on the reap chain log (var/rc120-chain.jsonl):
    the exit-120 instrument. The reap command has died at
    exit 120 with zero output in flap-peak windows; the
    chain log bounds the next death — enter without
    pass-done dies inside the lease pass, pass-done without
    a collector line dies in or around the collector child,
    and the collector's own returncode is recorded whenever
    the parent lives to see it. Evidence only, swallow-
    guarded like the last-reap stamp it rides beside."""
    try:
        import datetime

        var = REPO / "var"
        var.mkdir(parents=True, exist_ok=True)
        line = json.dumps(
            {"at": datetime.datetime.now(datetime.UTC).isoformat(), **event}
        )
        with open(var / "rc120-chain.jsonl", "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except Exception:  # noqa: BLE001 — evidence only, never the duty
        pass


def _reap_with_collector(gate=None) -> dict:
    """The reap duty: the lease pass, then the standing
    collector — stale detached run records get the poll their
    consumer never ran — inside the command budget. Guarded
    throughout: a collection failure reports in the result's
    collect block and never breaks the reap duty itself."""
    import subprocess
    import time

    started = time.monotonic()
    _chain_log({"phase": "enter"})
    result = lease.reap(cr.colab, REPO, gate=gate)
    _chain_log({"phase": "pass-done", "elapsed_s": round(time.monotonic() - started, 1)})
    try:
        var = REPO / "var"
        var.mkdir(parents=True, exist_ok=True)
        lease.foundation.staged_write(var / "last-reap.json", json.dumps(result, indent=2).encode())
    except Exception:  # noqa: BLE001 — evidence only, never the duty
        pass
    remaining = _reap_command_budget_s() - (time.monotonic() - started)
    if remaining < _COLLECT_MIN_REMAINING_S:
        _chain_log({"phase": "exit", "collect": "skipped-budget"})
        result["collect"] = {"skipped": "command-budget", "remaining_s": round(remaining, 1)}
        return result
    env = dict(os.environ)
    env["COLAB_COLLECT_BUDGET_S"] = str(max(0.0, remaining - 5.0))
    try:
        child = subprocess.run([sys.executable, str(REPO / "bin" / "venue-run"), "--collect-stale"], capture_output=True, text=True, timeout=remaining, env=env)
        _chain_log(
            {
                "phase": "collector-done",
                "returncode": child.returncode,
                "stderr_tail": (child.stderr or "")[-200:],
            }
        )
        result["collect"] = json.loads(child.stdout)
    except subprocess.TimeoutExpired:
        _chain_log({"phase": "collector-timeout", "budget_s": round(remaining, 1)})
        result["collect"] = {"error": "command-budget", "budget_s": round(remaining, 1)}
    except Exception as exc:  # noqa: BLE001
        _chain_log({"phase": "collector-error", "error": type(exc).__name__})
        result["collect"] = {"error": type(exc).__name__}
    _chain_log({"phase": "exit"})
    return result


def main() -> int:
    try:
        parsed = argv_mod.parse(DECL, sys.argv[1:])
    except argv_mod.UsageError as exc:
        print(str(exc), file=sys.stderr)
        print(argv_mod.help_text(DECL), file=sys.stderr)
        return 2
    if "help" in parsed:
        print(parsed["help"])
        return 0
    cmd = parsed["verb"]
    flags = parsed["flags"]
    pos = parsed["positionals"]
    # A local-venue acquire touches no Colab state: it needs
    # neither the Colab login nor the transient mirror.
    local_acquire = cmd == "acquire" and flags.get("venue") == "local"
    if not local_acquire:
        if not TOKEN.exists() and not os.environ.get("COLAB_BIN"):
            print("colab-lease: STAGED — no colab login yet.", file=sys.stderr)
            return 2
        cr.mirror("restore")
    if cmd == "status":
        result = lease.status(cr.colab, REPO, pos.get("session"))
    elif cmd == "acquire":
        hours, err = _hours(flags, "acquire")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(flags.get("caller"))
        shape = _shape(parsed) if err is None else None
        if err is None and shape is None:
            err = "acquire requires --shape ID"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        if local_acquire:
            result = lease.acquire_local(REPO, shape, caller=caller, hours=hours)
            print(json.dumps(result, indent=2, default=str))
            return 0
        result = lease.acquire(cr.colab, REPO, shape, hours=hours, via=flags.get("via"), caller=caller, create=flags["create"])
        if result.get("host_changed") and result.get("record"):
            # Initiation-time approval, Step 2: this entry point just
            # birthed (or adopted) a session on a new tunnel host —
            # prime this scope's own approval card now, in the same
            # minute, rather than letting it surface on a later call.
            result["prime"] = lease.prime_session_host(cr.colab, REPO, result["record"]["session"])
    elif cmd == "extend":
        hours, err = _hours(flags, "extend", required=True)
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(flags.get("caller"))
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.extend(cr.colab, REPO, pos["session"], hours, caller=caller)
    elif cmd == "adopt":
        hours, err = _hours(flags, "adopt")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(flags.get("caller"))
        deadline_raw = flags.get("deadline")
        deadline = None
        if err is None and deadline_raw is not None:
            if hours is not None:
                err = "adopt takes --deadline or --hours, not both"
            else:
                try:
                    deadline = datetime.fromisoformat(deadline_raw)
                except ValueError:
                    err = "--deadline needs an ISO timestamp"
        session = pos.get("session")
        endpoint_flag = flags.get("endpoint")
        if err is None and not session and endpoint_flag is None:
            err = "adopt requires a session name or --endpoint"
        if err is None and session and endpoint_flag is not None:
            err = "adopt takes a session name or --endpoint, not both"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        if endpoint_flag is not None:
            result = lease.adopt_nameless(cr.colab, REPO, endpoint_flag, deadline=deadline, hours=hours, caller=caller, shape=flags.get("shape"))
        else:
            result = lease.adopt_orphan(cr.colab, REPO, session, deadline=deadline, hours=hours, caller=caller, shape=flags.get("shape"))
    elif cmd == "shorten":
        hours, err = _hours(flags, "shorten")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(flags.get("caller"))
        deadline_raw = flags.get("deadline")
        deadline = None
        if err is None:
            if (deadline_raw is None) == (flags.get("hours") is None):
                err = "shorten requires exactly one of --deadline ISO or --hours H"
            elif deadline_raw is not None:
                try:
                    deadline = datetime.fromisoformat(deadline_raw)
                except ValueError:
                    err = "--deadline needs an ISO timestamp"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.shorten(cr.colab, REPO, pos["session"], deadline=deadline, hours=hours, caller=caller)
    elif cmd == "claim-sync":
        caller, err = resolve_cli_caller(flags.get("caller"))
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.claim_sync(REPO, pos["session"], caller=caller)
    elif cmd == "release-sync":
        caller, err = resolve_cli_caller(flags.get("caller"))
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.release_sync_claim(REPO, pos["session"], caller=caller)
    elif cmd == "release":
        session = pos.get("session")
        rec = lease.load_record(REPO, session) if session else None
        if rec and (rec.get("venue") or "colab") == "local":
            result = lease.release_local(REPO, session)
        else:
            result = lease.release(cr.colab, REPO, session=session)
    elif cmd == "grant":
        hours, err = _hours(flags, "grant", required=True)
        burst = flags.get("burst")
        if err is None and burst is not None and burst not in lease.catalog_shapes(REPO, cr.colab):
            err = f"unknown burst shape {burst!r}"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.write_grant(REPO, hours, burst_shape=burst)
    elif cmd == "extend-grant":
        hours, err = _hours(flags, "extend-grant", required=True)
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.extend_grant(cr.colab, REPO, hours)
    elif cmd == "ungrant":
        result = lease.ungrant(cr.colab, REPO)
    elif cmd == "standing":
        result = lease.standing_duty(cr.colab, REPO)
        result["bridge"] = lease.bridge_duty(cr.colab, REPO)
    elif cmd == "state":
        portions = {
            "records": lease.state_records,
            "specs": lease.state_specs,
            "budget": lease.state_budget,
            "grant": lease.state_grant,
            "meta": lease.state_meta,
            "orphans": lease.state_orphans,
            "listeners": lambda colab, repo: lease.state_listeners(repo),
        }
        part = flags.get("part")
        if part is None:
            result = lease.state(cr.colab, REPO)
        else:
            result = portions[part](cr.colab, REPO)
    elif cmd == "budget-caps":
        updates = {}
        err = None
        cap_flags = {"daily": "daily", "monthly": "monthly", "standing-daily": "standing_daily"}
        for name, key in cap_flags.items():
            if name in parsed["present"]:
                raw = flags[name]
                if raw.lower() == "none":
                    updates[key] = None
                else:
                    try:
                        updates[key] = float(raw)
                    except ValueError:
                        err = f"--{name} needs a number or 'none'"
        if err is None:
            for name in ("venue", "account"):
                if name in parsed["present"]:
                    updates[name] = flags[name]
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.set_budget_caps(REPO, **updates)
    elif cmd == "accounts":
        result = lease.accounts_state(REPO)
    elif cmd == "admission":
        caller, err = resolve_cli_caller(flags.get("caller"))
        shape = _shape(parsed) if err is None else None
        if err is None and shape is None:
            err = "admission requires --shape ID"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        if shape not in lease.catalog_shapes(REPO):
            result = {"action": "unknown-shape", "shape": shape}
        else:
            refusal = lease.enforce_session_admission(REPO, shape, via=flags.get("via"), seam="wrapper", caller=caller)
            result = refusal if refusal is not None else {"action": "admitted", "shape": shape, "caller": caller}
    elif cmd == "plan":
        shape, err = _shape(parsed), None
        if shape is None:
            err = "plan requires --shape ID"
        if err is None and shape not in lease.catalog_shapes(REPO, cr.colab):
            err = f"unknown shape {shape!r}"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        entry = lease.catalog_shapes(REPO, cr.colab)[shape]
        session = lease.generate_session_name(REPO, cr.colab)
        result = {"action": "planned", "shape": shape, "session": session, "args": ["new", "-s", session] + lease._session_shape_args(entry)}
    elif cmd == "keepalive":
        rec = lease.load_record(REPO)
        if not rec:
            result = {"action": "no-lease"}
        else:
            launched = lease.ensure_keepalive(cr.colab, REPO, rec["session"])
            import time as _time

            _time.sleep(3)
            age = lease.heartbeat_age(cr.colab, REPO, rec["session"])
            result = {"action": "keepalive-ensured", **launched, "heartbeat_age_s": round(age, 1) if age is not None else None}
    elif cmd == "auto":
        result = lease.auto_acquire(cr.colab, REPO)
    elif cmd == "request":
        # --via is the caller claim's legacy spelling; both
        # feed the one governed claim (--caller wins when both
        # are presented).
        claim = flags.get("caller") if flags.get("caller") is not None else flags.get("via")
        caller, err = resolve_cli_caller(claim)
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        at = flags.get("at")
        if at is not None:
            try:
                datetime.fromisoformat(at)
            except ValueError:
                print("colab-lease: --at needs an ISO timestamp", file=sys.stderr)
                return 2
        result = lease.write_request(REPO, reason=flags.get("reason") or "", shape=_shape(parsed), caller=caller, not_before=at)
    elif cmd == "release-session":
        endpoint_flag = flags.get("endpoint")
        session = pos.get("session")
        if endpoint_flag is not None and session:
            print("colab-lease: release-session takes a session name or --endpoint, not both", file=sys.stderr)
            return 2
        if endpoint_flag is not None:
            result = lease.release_endpoint(cr.colab, REPO, endpoint_flag)
        elif session:
            result = lease.release_session(cr.colab, REPO, session)
        else:
            print("colab-lease: release-session needs a session name or --endpoint", file=sys.stderr)
            return 2
    elif cmd == "unrequest":
        had = lease.load_request(REPO) is not None
        lease.clear_request(REPO)
        result = {"action": "request-cleared" if had else "no-demand"}
    elif cmd == "reap":
        pending_csv = flags.get("gate-pending-hosts")
        probe_csv = flags.get("gate-probe-hosts")
        gate = None
        err = None
        if pending_csv is not None or probe_csv is not None:
            try:
                gate = lease.parse_gate_scope(pending_csv, probe_csv)
            except ValueError as exc:
                err = str(exc)
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = _reap_with_collector(gate)
    print(json.dumps(result, indent=2))
    cr.mirror("capture")
    return 0 if result.get("action") not in ("refused-budget", "create-failed", "auto-failed", "standing-failed", "standing-refused-budget", "extend-no-lease", "extend-unknown", "extend-standing-managed", "grant-inactive", "caps-invalid", "unknown-shape", "shape-refused", "shape-mismatch", "caller-start-refused", "session-has-record", "session-stop-failed", "release-absent", "release-unknown", "adopt-has-record", "adopt-absent", "adopt-unknown", "adopt-deadline-past", "adopt-deadline-shortens", "adopt-no-deadline", "adopt-shape-ambiguous", "adopt-shape-unknown", "adopt-shape-conflict", "adopt-bridge-managed", "adopt-handover-pending", "shorten-no-lease", "shorten-unknown", "shorten-standing-managed", "shorten-not-earlier", "shorten-deadline-past", "shorten-no-target", "sync-claim-refused-claim", "sync-claim-refused-activity", "sync-claim-unattributed", "sync-release-refused") else 1


if __name__ == "__main__":
    raise SystemExit(main())
