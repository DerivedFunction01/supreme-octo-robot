#!/usr/bin/env python3
"""Job dispatch to the local venue, over SSH.

Usage: local-run <job-name> [--caller TAG] [--detach]|local-run --poll RUN_ID|local-run --wait RUN_ID [--max SECONDS]

A job is a manifest at adapters/local/jobs/<name>/job.json:
{"script": "run.sh", "caller"?, "shape"?, "timeout_s"?} — the
script beside the manifest ships to the venue over SSH and runs
detached in the container under ~/runs/<run_id>/, so a dropped
connection never kills the job (the venue's own rule: long work
launches detached and is polled). The run's record is the
runner's own record shape, written through the runner's record
machinery with venue "local"; its terminal transition emits the
runner's one run-terminal event, so the runs portion serves a
local run beside every Colab run.

The lease is the local venue's registration (sync/lease's
acquire_local): the container is the venue — nothing is
created, priced, or kept alive; the record names the caller
and the window. Caller attribution is the lease core's own
registry, exactly as for a Colab run.

Record truth is the container's (launch-path plan, Step 2):
polls read the run dir through the lease core's tri-state
reader, a finished run finalizes from its exit file (state
from the code, completion time from the file's mtime), and
even a terminal record face is re-derived when the exit
file contradicts it — the record never outranks the run dir.

Launch transport warmup is the dispatch's own discipline
(Step 3): an SSH step that times out — the signature of a
managed transport still coming up, the venue healthy
minutes later — retries with bounded backoff inside the
same fire, and a refusal after the bound names the warmup,
never the venue.
"""

import importlib.util
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _load  # noqa: E402

runner = _load.sync("runner")
for _name in runner.__all__:
    globals()[_name] = getattr(runner, _name)
del _name

_spec_l = importlib.util.spec_from_file_location(
    "lease", REPO / "sync" / "lease" / "__init__.py",
    submodule_search_locations=[str(REPO / "sync" / "lease")])
lease = importlib.util.module_from_spec(_spec_l)
sys.modules["lease"] = lease
_spec_l.loader.exec_module(lease)
local_venue = lease.local_venue
JOBS = REPO / "adapters" / "local" / "jobs"
POLL_S = 5


def _fail(msg: str, code: int = 2) -> int:
    print(f"local-run: {msg}", file=sys.stderr)
    return code


def _ssh(target: dict, remote: str, input_bytes: bytes | None = None, timeout: int = 90) -> subprocess.CompletedProcess:
    return subprocess.run(
        local_venue.ssh_args(REPO, target) + [remote],
        input=input_bytes, capture_output=True, timeout=timeout)


# Launch warmup discipline (launch-path plan, Step 3): the
# five recorded specimens timed out on an SSH launch step
# with the path healthy minutes later, and the record folded
# FAILED "venue unreachable" over runs that had in fact
# landed or would have on a retry — a launch timeout is the
# warmup signature of a managed transport still coming up
# (ensure_transport starts it, but its tunnel can take
# longer than one step's bound to carry SSH), not a verdict
# on the venue. Each step retries on a timeout with bounded
# backoff inside the same fire; only a step that times out
# on every attempt refuses, and its refusal names the
# warmup. An OSError — the ssh client itself could not
# run — is a different face and keeps the unreachable name.
LAUNCH_ATTEMPTS = 3
LAUNCH_BACKOFF_S = (10, 30)


def _launch_step(step) -> tuple[str | None, bool]:
    """Run one launch step under the warmup discipline.
    Returns (error, timed_out): error is the step's own
    refusal for an answered failure; timed_out marks a step
    that timed out on every attempt. OSError propagates —
    it is not the warmup signature."""
    for attempt in range(LAUNCH_ATTEMPTS):
        try:
            return step(), False
        except subprocess.TimeoutExpired:
            if attempt + 1 < LAUNCH_ATTEMPTS:
                time.sleep(LAUNCH_BACKOFF_S[min(attempt, len(LAUNCH_BACKOFF_S) - 1)])
    return None, True


def _launch(rec: dict, script: bytes, target: dict) -> str | None:
    """Ship the script and launch it detached on the venue.
    Returns an error string, or None on a confirmed launch.
    Each step rides the warmup discipline (_launch_step): a
    step that answered is never repeated, so a retry resumes
    the sequence where the timeout fell."""
    base = f"runs/{rec['run_id']}"

    def mkdir() -> str | None:
        r = _ssh(target, f"mkdir -p ~/{base}", timeout=90)
        if r.returncode != 0:
            return f"venue mkdir failed: {r.stderr.decode(errors='replace').strip()[-200:]}"
        return None

    def upload() -> str | None:
        r = _ssh(target, f"cat > ~/{base}/run.sh", input_bytes=script, timeout=90)
        if r.returncode != 0:
            return f"script upload failed: {r.stderr.decode(errors='replace').strip()[-200:]}"
        return None

    def launch() -> str | None:
        # Marker-guarded on the venue: an attempt that timed
        # out client-side may still have started the job, and
        # the retry must confirm that launch — the guard
        # answers "launched" without starting a second copy.
        cmd = (
            f"cd ~/{base} && if [ ! -f .launched ]; then touch .launched; "
            f"nohup bash -c 'bash run.sh > output.log 2>&1; echo $? > exit' "
            ">/dev/null 2>&1 & fi; echo launched")
        r = _ssh(target, cmd, timeout=90)
        if r.returncode != 0 or b"launched" not in r.stdout:
            return f"launch failed: {r.stderr.decode(errors='replace').strip()[-200:]}"
        return None

    for step in (mkdir, upload, launch):
        try:
            err, timed_out = _launch_step(step)
        except OSError as exc:
            return f"venue unreachable: {exc}"
        if timed_out:
            return (f"venue warmup: launch timed out on all {LAUNCH_ATTEMPTS} attempts; "
                    "the transport was still warming and the venue was not reached — "
                    "the dispatch may be retried")
        if err is not None:
            return err
    return None


def _poll(rec: dict, target: dict) -> dict:
    """One poll of the run's container state, through the
    lease core's tri-state reader (local_venue.read_run_state):
    an exit file finalizes the record through the runner's
    shared local finalize — terminal state from the code,
    completion time from the exit file's own mtime; no exit
    file yet is "running"; an unreadable container is
    "running" with the unreachable flag — a lost read is
    never a verdict."""
    reading = local_venue.read_run_state(REPO, rec, target=target)
    if reading["reading"] == "exit":
        state = finalize_local_record(rec, reading)
        return {"state": state, "exit_code": reading["exit_code"]}
    if reading["reading"] == "unknown":
        return {"state": "running", "venue_unreachable": True}
    return {"state": "running"}


def _rederive(rec: dict, target: dict) -> dict | None:
    """The reader pass over a terminal record face: the
    container's exit file outranks the record, so a face it
    contradicts — an orphan flip over a finished run (the
    decxc shape: face "orphaned", run dir holding exit 0),
    a launch-time failure the detached run outlived — is
    re-derived from the container through the shared
    finalize. A face the exit file confirms, and any
    non-exit reading, stands as written. Returns the
    derived outcome, or None when the face stands."""
    reading = local_venue.read_run_state(REPO, rec, target=target)
    if reading["reading"] != "exit":
        return None
    code = reading["exit_code"]
    state = "complete" if code == 0 else "failed"
    if rec.get("state") == state and rec.get("exit_code") == code:
        return None
    finalize_local_record(rec, reading)
    return {"state": state, "exit_code": code, "rederived": True}


def _wait(rec: dict, target: dict, max_s: int, timeout_s: int) -> int:
    deadline = time.monotonic() + min(max_s, timeout_s)
    while True:
        out = _poll(rec, target)
        if out["state"] != "running":
            print(json.dumps({"run_id": rec["run_id"], **out}, indent=2))
            return 0 if out["state"] == "complete" else 1
        if time.monotonic() > deadline:
            print(json.dumps({"run_id": rec["run_id"], "state": "running", "note": "wait bound reached; the run continues detached"}, indent=2))
            return 0
        time.sleep(POLL_S)


def _record_target(rec):
    """The SSH target a run record belongs to: the target the
    record itself carries, else its shape's binding, else the
    venue's only target."""
    tid = rec.get("target")
    if isinstance(tid, str) and tid:
        return local_venue.venue_target(REPO, tid)
    _shape, _tid, target = local_venue.shape_target(REPO, rec.get("shape") or "")
    return target or local_venue.venue_target(REPO)


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return _fail("usage: local-run <job-name> [--caller TAG] [--detach] | --poll RUN_ID | --wait RUN_ID [--max SECONDS]")
    if args[0] in ("--poll", "--wait"):
        rec = load_run_record(args[1]) if len(args) > 1 else None
        if rec is None:
            return _fail("a run id is required and must name a run record")
        if rec.get("venue") != "local":
            return _fail(f"run {rec['run_id']} is not a local-venue run")
        if rec.get("state") in TERMINAL_STATES:
            # A terminal face is accepted only after the
            # reader pass: the container's exit file outranks
            # the record (Step 2's poll half), so a face it
            # contradicts is re-derived before it is served.
            target = _record_target(rec)
            if target is not None:
                local_venue.ensure_transport(target)
                derived = _rederive(rec, target)
                if derived is not None:
                    print(json.dumps({"run_id": rec["run_id"], **derived}, indent=2))
                    return 0 if derived["state"] == "complete" else 1
            print(json.dumps({"run_id": rec["run_id"], "state": rec["state"]}, indent=2))
            return 0 if rec["state"] == "complete" else 1
        target = _record_target(rec)
        if target is None:
            return _fail("no local venue target resolves for this run (config/lease.json venue_targets.local)")
        local_venue.ensure_transport(target)
        if args[0] == "--poll":
            out = _poll(rec, target)
            print(json.dumps({"run_id": rec["run_id"], **out}, indent=2))
            return 0
        max_s = 3600
        if "--max" in args:
            try:
                max_s = int(args[args.index("--max") + 1])
            except (IndexError, ValueError):
                return _fail("--max must be an integer number of seconds")
        return _wait(rec, target, max_s, int(rec.get("timeout_s") or 18000))

    job_name = args[0]
    manifest_path = JOBS / job_name / "job.json"
    if not manifest_path.exists():
        return _fail(f"no job manifest at {manifest_path}")
    job = json.loads(manifest_path.read_text())
    if job.get("venue") not in (None, "local"):
        return _fail(f"job {job_name}: venue {job.get('venue')!r} is not the local venue — dispatch it on its own venue's runner")
    script_name = job.get("script") or "run.sh"
    script_path = manifest_path.parent / script_name
    if not script_path.exists():
        return _fail(f"job {job_name}: script {script_name} not found beside the manifest")
    caller_flag = None
    if "--caller" in args:
        try:
            caller_flag = args[args.index("--caller") + 1]
        except IndexError:
            return _fail("--caller needs a value")
    claim_raw = caller_flag if caller_flag is not None else job.get("caller")
    claim_err = lease.caller_claim_error(REPO, flag=claim_raw, env=os.environ.get("COLAB_CALLER"))
    if claim_err:
        return _fail(claim_err)
    caller = lease.resolve_caller(REPO, flag=claim_raw, env=os.environ.get("COLAB_CALLER"))
    shape_id = job.get("shape") or "local"
    acquired = lease.acquire_local(REPO, shape_id, caller=caller, hours=job.get("hours"))
    if acquired.get("action") not in ("created", "adopted"):
        return _fail(f"local lease refused: {acquired.get('reason') or acquired.get('action')}")
    session = acquired["record"]["session"]
    target = _record_target(acquired["record"])
    if target is None:
        return _fail("no local venue target resolves for this shape (config/lease.json venue_targets.local)")
    local_venue.ensure_transport(target)
    run_id = f"{job_name}-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}"
    rec = {"run_id": run_id, "job": job_name, "shape": shape_id, "session": session,
           **({"target": acquired["record"]["target"]} if acquired["record"].get("target") else {}),
           "caller": caller, "venue": "local", "state": "starting", "started_at": now(),
           "timeout_s": int(job.get("timeout_s") or 18000)}
    save_record(rec)
    err = _launch(rec, script_path.read_bytes(), target)
    if err is not None:
        mark_terminal(rec, "failed", error=err, finished_at=now())
        print(json.dumps({"run_id": run_id, "state": "failed", "error": err}, indent=2))
        return 1
    rec.update(state="running")
    save_record(rec)
    if "--detach" in args:
        print(json.dumps({"run_id": run_id, "state": "running", "session": session}, indent=2))
        return 0
    return _wait(rec, target, int(job.get("timeout_s") or 18000), int(job.get("timeout_s") or 18000))


if __name__ == "__main__":
    raise SystemExit(main())
