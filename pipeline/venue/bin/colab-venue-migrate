#!/usr/bin/env python3
"""The §10.3 venue-stamp migration, as an operator verb.

    colab-venue-migrate --var <dir> --runs <dir> [--venue colab] [--dry-run]

Stamps the legacy lease/run record stock with its venue key
(plan §10.3, ruled: stamp once, no read-time default) and
quarantines the hygiene remainder (unparseable run records,
the record in a state outside the contract vocabulary) with
bytes preserved. Prints the census as JSON. The mechanism is
sync/venue_migrate.py; this wrapper is its CLI seam, in the
bin/ pattern. S11's cutover runs this verb against the
then-live store.
"""
import importlib.util as ilu
import sys
from pathlib import Path

_paths_spec = ilu.spec_from_file_location(
    "venue_paths", Path(__file__).resolve().parent.parent / "paths.py")
_paths = ilu.module_from_spec(_paths_spec)
_paths_spec.loader.exec_module(_paths)

REPO = _paths.REPO_RESOLVED

_spec = ilu.spec_from_file_location("venue_migrate", REPO / "sync" / "venue_migrate.py")
venue_migrate = ilu.module_from_spec(_spec)
_spec.loader.exec_module(venue_migrate)

_argv_spec = ilu.spec_from_file_location(
    "platform_argv", REPO.parent / "platform" / "argv.py")
argv_mod = ilu.module_from_spec(_argv_spec)
_argv_spec.loader.exec_module(argv_mod)

# The operator surface, declared once for the unified
# argument parser (pipeline/platform/argv.py): this
# wrapper validates against the declaration (unknown or
# missing flags refuse at exit 2 with generated help)
# before the mechanism's own entry point runs.
DECL = {
    "name": "colab-venue-migrate",
    "summary": "Stamp the legacy lease/run record stock with its venue key; quarantine the hygiene remainder with bytes preserved.",
    "flags": {
        "var": {"takes_value": True, "required": True, "help": "the store's var dir"},
        "runs": {"takes_value": True, "required": True, "help": "the store's results/runs dir"},
        "venue": {"takes_value": True, "default": "colab", "help": "venue key to stamp"},
        "dry-run": {"safety": True, "help": "census only; stamp nothing"},
    },
}


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        parsed = argv_mod.parse(DECL, argv)
    except argv_mod.UsageError as exc:
        print(str(exc), file=sys.stderr)
        print(argv_mod.help_text(DECL), file=sys.stderr)
        return 2
    if "help" in parsed:
        print(parsed["help"])
        return 0
    return venue_migrate.main(argv)


if __name__ == "__main__":
    raise SystemExit(main())
