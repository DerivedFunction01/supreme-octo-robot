#!/usr/bin/env python3
"""Auto-extension guard entry point: extend every live lease
before it lapses (see sync/extend_guard.py). Prints one JSON
line per action or finding; exit 0 clean, 3 on findings."""

import importlib.util
import json
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _load

REPO = _load.REPO

spec = importlib.util.spec_from_loader("venue_run", SourceFileLoader("venue_run", str(REPO / "bin" / "venue-run")))
cr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(cr)

spec_l = importlib.util.spec_from_file_location(
    "lease", REPO / "sync" / "lease" / "__init__.py",
    submodule_search_locations=[str(REPO / "sync" / "lease")])
lease = importlib.util.module_from_spec(spec_l)
sys.modules["lease"] = lease
spec_l.loader.exec_module(lease)

spec_g = importlib.util.spec_from_file_location("extend_guard", REPO / "sync" / "extend_guard.py")
guard = importlib.util.module_from_spec(spec_g)
spec_g.loader.exec_module(guard)

argv_mod = _load.platform_argv()

# No-argument tool (the unified argument parser's guard
# form): the declaration is empty, so any argument at all
# is a usage refusal at exit 2. Exit 3 on findings is the
# declared verdict code.
DECL = {
    "name": "venue-extend-guard",
    "summary": "Auto-extension guard: extend every live lease before it lapses. Takes no arguments.",
    "verdict_codes": {"3": "the guard ran and has findings"},
}


def main(argv=None) -> int:
    try:
        parsed = argv_mod.parse(DECL, sys.argv[1:] if argv is None else argv)
    except argv_mod.UsageError as exc:
        print(str(exc), file=sys.stderr)
        print(argv_mod.help_text(DECL), file=sys.stderr)
        return 2
    if "help" in parsed:
        print(parsed["help"])
        return 0
    code, lines = guard.run_guard(lease, cr.colab, REPO)
    for line in lines:
        print(json.dumps(line, sort_keys=True))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
