#!/usr/bin/env python3
"""Session liveness checker (session liveness plan,
.plans/2026-11-06-session-liveness-schedule.md).

    venue-liveness <session>   check one live lease
    venue-liveness --sync      reconcile registry entries with
                               the live records (janitor mode)

The checker reads ONLY local files — the lease record, the
CLI binding, the approval-gate state, the runner's run
records — and never dials the session, so it cannot mint an
approval card and cannot be gated by the approval gate whose
state it watches. It keeps var/liveness-<session>.json: open
findings with first-seen times and the approval-escalation
episodes already reported.

Speech contract (the scheduler entry reports on failure):
exit 0 = healthy, steady state, or the session is gone (the
checker first deletes its own registry entry and state file,
so a leaked schedule self-heals within one interval);
exit 3 = something must be said, with one LIVENESS line per
item: a finding that newly opened, the approval escalation
the first time an episode crosses the threshold, or the
all-clear when the last open finding resolves. A finding
that merely persists is silent: each distinct stall is
reported exactly once, by the escalation body that works the
resulting ping (pipeline/scheduling/bodies/venue-liveness.md,
which routes mechanical findings to the owning thread
and the approval block to the main chat).

Checks (each maps to a stall this machinery has produced):
record/binding agreement, binding host vs record host,
deadline present and not past, last pulse verdict and its
freshness (the lease core stamps last_pulse_at /
last_pulse_result on the record), approval blockage age
from the gate state (contact_ok false since first_seen),
and the funnel's served binding state (var/binding-state
.json): a damaged CLI session-binding store serves as
binding-damaged, so a fleet-wide blindness reads as its
own finding rather than as every session missing. For a
local record whose target is a forwarder, the forwarder's
own state file (<pin>.state.json, written by the forwarder
beside its pin) is read too: every credential source
failing over a sustained window serves as
forwarder-credential-exhaustion in place of the bare
pulse-failing it explains, and a recently established
tunnel in that record is positive evidence the route is
alive, clearing the pulse finding the tunnel's health
contradicts.
The venue-state surface is consumed here too (venue-state
mechanism, step 5): a fresh state file for the record's
venue (var/venue-state-<venue>.json — the sampler writes
the local targets', the reap pass writes the Colab
sessions' and the fleet's) reading "saturated" stands as
saturated-standing, a fresh "idle" as idle-capacity, and a
job whose run record carries the actuator's reap stamp as
wedged-killed — the owning lane's notification on this
escalation surface, in this speech contract's form. A
state file's disk block (the sampler's per-target reading
against the instance's warn/stop budget) at warn or stop
stands as disk-warn / disk-stop for the target, and a dark
venue whose carried last reading was at warn or stop
stands as disk-last — the disk warning the host-side
guard only ever wrote to its own log, on the surface that
is read.
Runner-side work facts (runs in flight on the session, a
pending demand) are recorded in the state file for the
escalation body's context; judging whether the owning
thread has work queued stays with the approval sweeper's
idleness duty, which reads the threads' turns.
"""
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlparse

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _load

REPO = _load.REPO
liveness_entry = _load.sync("liveness_entry", "venue_liveness_entry")
writer = _load.platform_writer()
argv_mod = _load.platform_argv()

# The operator surface, declared once for the unified
# argument parser (pipeline/platform/argv.py): exactly one
# session positional, or --sync alone; anything else is a
# usage refusal at exit 2. The speech contract's exit 3 is
# the declared verdict code.
DECL = {
    "name": "venue-liveness",
    "summary": "Session liveness checker: reads only local files, never dials the session.",
    "flags": {
        "sync": {"help": "reconcile registry entries with the live records (janitor mode)"},
    },
    "positionals": [{"name": "session"}],
    "verdict_codes": {"3": "something must be said (one LIVENESS line per item on stdout)"},
}

APPROVAL_ESCALATE_S = int(os.environ.get("VENUE_LIVENESS_APPROVAL_ESCALATE_S", "1800"))
PULSE_STALE_S = int(os.environ.get("VENUE_LIVENESS_PULSE_STALE_S", "1800"))
# The forwarder window: on the order of the beacon cadence
# (the beacon restocks forwarder pins every ten minutes), so
# a credential-exhaustion reading must outlast one restock
# cycle before it speaks, and an established tunnel counts
# as recent route evidence for the same span.
FWD_EXHAUSTION_S = int(os.environ.get("VENUE_LIVENESS_FWD_EXHAUSTION_S", "600"))
SESSION_GRACE_S = int(os.environ.get("VENUE_LIVENESS_SESSION_GRACE_S", "900"))
# The venue-state surface's freshness bound for findings:
# the sampler writes every 120 s and the reap pass at its
# own cadence, so a file older than this is a dark surface,
# and a dark surface is no finding.
VENUE_STATE_STALE_S = int(os.environ.get("VENUE_LIVENESS_VENUE_STATE_STALE_S", "900"))
TERMINAL_RUN_STATES = {"complete", "failed", "orphaned"}


def _load(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return default


def _dt(text):
    if not text:
        return None
    try:
        return datetime.fromisoformat(str(text).replace("Z", "+00:00"))
    except ValueError:
        return None


def _age_s(now, then) -> int:
    return int((now - then).total_seconds()) if then else -1


def gate_state_path() -> Path:
    env = os.environ.get("VENUE_LIVENESS_GATE_STATE")
    return Path(env) if env else Path.home() / "hooks" / "state" / "colab-lease-approval.json"


def bindings_path() -> Path:
    env = os.environ.get("VENUE_LIVENESS_BINDINGS")
    return Path(env) if env else Path.home() / ".config" / "colab-cli" / "sessions.json"


def binding_host(session: str):
    binding = _load(bindings_path(), {})
    if not isinstance(binding, dict):
        return None, False
    entry = binding.get(session)
    if entry is None:
        return None, False
    url = entry.get("url") if isinstance(entry, dict) else entry
    if not isinstance(url, str):
        return None, True
    return urlparse(url if "://" in url else f"https://{url}").hostname, True


def local_target_for(rec):
    """The configured SSH target a local-venue record binds
    through, or None: the record's own target id, else its
    shape's `target` binding, else the venue's only target
    (or the "local" one). The lease config is a local file
    (derived from the var dir's parent, the same root the
    record lives under), so the checker's no-dial rule
    holds."""
    cfg = _load(liveness_entry.var_dir(REPO).parent / "config" / "lease.json", {})
    if not isinstance(cfg, dict):
        return None
    block = (cfg.get("venue_targets") or {}).get("local")
    targets = {}
    if isinstance(block, dict) and block.get("host") and block.get("user"):
        targets = {"local": block}
    elif isinstance(block, dict):
        targets = {k: v for k, v in block.items() if isinstance(v, dict) and v.get("host") and v.get("user")}
    if not targets:
        return None
    if rec.get("target") in targets:
        return targets[rec.get("target")]
    shapes = (cfg.get("venue_shapes") or {}).get("local") or []
    for entry in shapes:
        if isinstance(entry, dict) and entry.get("id") == rec.get("shape") and entry.get("target") in targets:
            return targets[entry.get("target")]
    if len(targets) == 1:
        return next(iter(targets.values()))
    return targets.get("local")


def local_target_present(rec) -> bool:
    """A local-venue record's binding is its configured SSH
    target, not the CLI session binding: present when a target
    resolves for the record."""
    return local_target_for(rec) is not None


def local_target_id(rec):
    """The target id a local-venue record binds through —
    the key local_target_for resolves to a target dict, by
    the same legs (the record's own target id, else its
    shape's `target` binding, else the venue's only target
    or the "local" one). The venue-state file is keyed by
    this id."""
    cfg = _load(liveness_entry.var_dir(REPO).parent / "config" / "lease.json", {})
    if not isinstance(cfg, dict):
        return None
    block = (cfg.get("venue_targets") or {}).get("local")
    targets = {}
    if isinstance(block, dict) and block.get("host") and block.get("user"):
        targets = {"local": block}
    elif isinstance(block, dict):
        targets = {k: v for k, v in block.items() if isinstance(v, dict) and v.get("host") and v.get("user")}
    if not targets:
        return None
    if rec.get("target") in targets:
        return rec.get("target")
    shapes = (cfg.get("venue_shapes") or {}).get("local") or []
    for entry in shapes:
        if isinstance(entry, dict) and entry.get("id") == rec.get("shape") and entry.get("target") in targets:
            return entry.get("target")
    if len(targets) == 1:
        return next(iter(targets))
    return "local" if "local" in targets else None


def _run_record(run_id):
    """One run record by id, from the runs store under the
    var dir's parent — the same root derivation
    local_target_for uses for the lease config, so the
    checker's reads stay under the root the record lives
    under."""
    runs = liveness_entry.var_dir(REPO).parent / "results" / "runs"
    rec = _load(runs / f"{run_id}.json", {})
    return rec if isinstance(rec, dict) else {}


def venue_state_findings(now, rec) -> dict:
    """The venue-state surface's standing findings for this
    record's venue (venue-state mechanism, step 5): the
    state files in the var dir are the measures' read
    surface and the checker is one of the measures. A fresh
    file reading "saturated" stands as saturated-standing;
    a fresh "idle" as idle-capacity; a job in the file whose
    run record carries the actuator's `reaped` stamp stands
    as wedged-killed:<run id> — the owning lane's
    notification, routed by the escalation body on the
    record's caller. The file's disk block at warn or stop
    stands as disk-warn:<target> / disk-stop:<target>; on
    an unreachable venue, the carried last reading at warn
    or stop stands as disk-last:<target>, naming the
    reading and its stamp. A stale or absent file is no
    finding: the surface's silence is not a verdict."""
    findings = {}
    venue = rec.get("venue") or "colab"
    keys = []
    if venue == "local":
        target_id = local_target_id(rec)
        if target_id:
            keys.append(target_id)
    elif venue == "colab":
        keys.append("colab")
        if rec.get("session"):
            keys.append(rec["session"])
    else:
        return findings
    var = liveness_entry.var_dir(REPO)
    for key in keys:
        state = _load(var / f"venue-state-{key}.json", {})
        if not isinstance(state, dict) or not state:
            continue
        sampled = _dt(state.get("sampled_at"))
        if sampled is None or _age_s(now, sampled) > VENUE_STATE_STALE_S or _age_s(now, sampled) < -60:
            continue
        if state.get("state") == "saturated":
            findings["saturated-standing"] = (
                f"venue {key} saturated: pids {state.get('pids_current')}/{state.get('pids_capacity')} "
                f"at {state.get('sampled_at')} — dispatches refuse until the table drains"
            )
        elif state.get("state") == "idle":
            findings["idle-capacity"] = (
                f"venue {key} idle: no live job trees "
                f"(pids {state.get('pids_current')}/{state.get('pids_capacity')}) — capacity available"
            )
        disk = state.get("disk")
        if isinstance(disk, dict) and disk.get("state") in ("warn", "stop"):
            level = disk["state"]
            if state.get("state") == "unreachable":
                findings[f"disk-last:{key}"] = (
                    f"venue {key} unreachable; last disk reading "
                    f"{disk.get('root_used_gb')} GB of stop budget {disk.get('stop_gb')} GB "
                    f"(warn at {disk.get('warn_gb')} GB) at {disk.get('disk_sampled_at')} "
                    f"— disk {level} when the venue went dark"
                )
            else:
                findings[f"disk-{level}:{key}"] = (
                    f"venue {key} disk {level}: root store {disk.get('root_used_gb')} GB "
                    f"against warn {disk.get('warn_gb')} GB / stop {disk.get('stop_gb')} GB "
                    f"at {state.get('sampled_at')}"
                )
        for job in state.get("jobs") or []:
            if not isinstance(job, dict):
                continue
            run_id = job.get("run_id")
            if not run_id:
                continue
            run = _run_record(run_id)
            reaped = run.get("reaped")
            if isinstance(reaped, dict):
                findings[f"wedged-killed:{run_id}"] = (
                    f"run {run_id} (caller {job.get('caller') or run.get('caller')}) "
                    f"reaped {reaped.get('reason')}: cpu {job.get('cpu_s')}s, "
                    f"delta {job.get('cpu_delta_s')}s, exit {reaped.get('exit_code')} — "
                    "record settled with the samples as evidence"
                )
    return findings


def forwarder_reading(now, rec):
    """(exhaustion detail or None, route-alive flag) from the
    forwarder state file of the record's target — the
    `<pin>.state.json` the forwarder writes beside its pin
    (local_compute_fwd.py). Exhaustion: a failing streak is
    open, every credential source the instance has attempted
    last failed (proxy-407 or connect-error), and the streak
    has run at least FWD_EXHAUSTION_S. Route-alive: the
    record's last overall outcome is an established tunnel
    inside the same window — positive evidence from the
    forwarder's own record, read as a local file, never a
    dial."""
    target = local_target_for(rec)
    pin = target.get("fwd_pin") if isinstance(target, dict) else None
    if not pin:
        return None, False
    state = _load(Path(str(pin) + ".state.json"), {})
    if not isinstance(state, dict) or not state:
        return None, False
    last_at = _dt(state.get("last_at"))
    alive = (
        state.get("last_outcome") == "established"
        and last_at is not None
        and 0 <= _age_s(now, last_at) <= FWD_EXHAUSTION_S
    )
    failing_since = _dt(state.get("failing_since"))
    sources = state.get("sources") if isinstance(state.get("sources"), dict) else {}
    attempted = [
        entry for entry in sources.values()
        if isinstance(entry, dict) and (entry.get("attempts") or 0) > 0
    ]
    all_failing = bool(attempted) and all(
        entry.get("last_outcome") in ("proxy-407", "connect-error") for entry in attempted
    )
    if (
        not alive
        and all_failing
        and failing_since is not None
        and (state.get("consecutive_failures") or 0) > 0
        and _age_s(now, failing_since) >= FWD_EXHAUSTION_S
    ):
        outcomes = ", ".join(
            f"{name}={entry.get('last_outcome')}"
            for name, entry in sorted(sources.items())
            if isinstance(entry, dict) and (entry.get("attempts") or 0) > 0
        )
        detail = (
            f"forwarder credential exhaustion: every credential source failing "
            f"for {_age_s(now, failing_since)}s (since {state.get('failing_since')}, "
            f"{state.get('consecutive_failures')} consecutive failures; {outcomes})"
        )
        return detail, False
    return None, alive


def find_record(session: str):
    for rec in liveness_entry.load_records(REPO):
        if rec.get("session") == session:
            return rec
    return None


def work_facts(session: str) -> dict:
    runs = []
    runs_dir = REPO / "results" / "runs"
    if runs_dir.is_dir():
        for f in sorted(runs_dir.glob("*.json")):
            rec = _load(f, {})
            if isinstance(rec, dict) and rec.get("session") == session and rec.get("state") not in TERMINAL_RUN_STATES:
                runs.append({"run_id": rec.get("run_id"), "job": rec.get("job"), "state": rec.get("state")})
    demand = _load(liveness_entry.var_dir(REPO) / "lease-request.json", None)
    return {"runs_in_flight": runs, "demand_pending": demand if isinstance(demand, dict) else None}


def compute_findings(now, rec, state) -> dict:
    findings = {}
    session = rec["session"]
    # Binding is per-venue: the CLI session binding binds home
    # (Colab) sessions only. A local record binds through its
    # configured SSH target; another venue's record is not this
    # binding's subject at all.
    venue = rec.get("venue") or "colab"
    if venue == "colab":
        host, present = binding_host(session)
        if not present:
            findings["binding-missing"] = "session absent from the CLI binding"
        elif host and rec.get("host") and host != rec["host"]:
            findings["host-divergence"] = f"record host {rec['host']} != binding host {host}"
    elif venue == "local":
        if not local_target_present(rec):
            findings["binding-missing"] = "no local target configured for the record"
    deadline = _dt(rec.get("deadline"))
    if deadline is None:
        findings["deadline-missing"] = "record carries no deadline"
    elif deadline < now:
        findings["deadline-overdue"] = f"deadline passed {_age_s(now, deadline)}s ago with the record still live (reap overdue)"
    acquired = _dt(rec.get("acquired_at"))
    pulse_at = _dt(rec.get("last_pulse_at"))
    pulse_result = rec.get("last_pulse_result")
    if pulse_result not in (None, "ok"):
        findings["pulse-failing"] = f"last pulse result {pulse_result!r} at {rec.get('last_pulse_at')}"
    elif pulse_at is None:
        if acquired and _age_s(now, acquired) > SESSION_GRACE_S:
            findings["pulse-stale"] = "no pulse verdict on the record"
    elif _age_s(now, pulse_at) > PULSE_STALE_S and acquired and _age_s(now, acquired) > SESSION_GRACE_S:
        findings["pulse-stale"] = f"no pulse verdict for {_age_s(now, pulse_at)}s (last at {rec.get('last_pulse_at')})"
    if venue == "local":
        # The forwarder's own record explains or contradicts
        # the pulse: exhaustion over the window is the finding
        # (the pulse failure is its symptom), and a recently
        # established tunnel is positive route evidence that
        # clears the pulse finding.
        exhaustion, route_alive = forwarder_reading(now, rec)
        if exhaustion is not None:
            findings.pop("pulse-failing", None)
            findings["forwarder-credential-exhaustion"] = exhaustion
        elif route_alive:
            findings.pop("pulse-failing", None)
    gate = _load(gate_state_path(), {})
    hosts = gate.get("hosts", {}) if isinstance(gate, dict) else {}
    gmeta = hosts.get(rec.get("host") or "")
    if isinstance(gmeta, dict) and not gmeta.get("contact_ok"):
        first_seen = _dt(gmeta.get("first_seen"))
        age = _age_s(now, first_seen)
        if age >= APPROVAL_ESCALATE_S:
            episode = f"{rec.get('host')}|{gmeta.get('first_seen')}"
            findings["approval-outstanding"] = (
                f"approval outstanding for host {rec.get('host')} for {age}s "
                f"(session {session}, caller {rec.get('caller')}); episode {episode}"
            )
            state["_episode"] = episode
    return findings


def main(argv) -> int:
    try:
        parsed = argv_mod.parse(DECL, argv)
    except argv_mod.UsageError as exc:
        print(str(exc), file=sys.stderr)
        print(argv_mod.help_text(DECL), file=sys.stderr)
        return 2
    if "help" in parsed:
        print(parsed["help"])
        return 0
    session = parsed["positionals"].get("session")
    if parsed["flags"]["sync"]:
        if session is not None:
            print("usage: venue-liveness <session> | --sync", file=sys.stderr)
            return 2
        records = liveness_entry.load_records(REPO)
        print(json.dumps(liveness_entry.reconcile(REPO, records)))
        return 0
    if session is None:
        print("usage: venue-liveness <session> | --sync", file=sys.stderr)
        return 2
    now = datetime.now(timezone.utc)
    rec = find_record(session)
    state_path = liveness_entry.var_dir(REPO) / f"liveness-{session}.json"
    if rec is None:
        # Gone: disarm self and state, silently — a leaked
        # entry self-heals here and never pings twice.
        liveness_entry.remove_for_session(REPO, session)
        return 0
    state = _load(state_path, {})
    if not isinstance(state, dict):
        state = {}
    prev_open = state.get("open") or {}
    episodes = state.get("approval_episodes") or {}
    episode = None
    probe = {}
    findings = compute_findings(now, rec, probe)
    episode = probe.get("_episode")
    binding_state = _load(liveness_entry.var_dir(REPO) / "binding-state.json", None)
    if isinstance(binding_state, dict) and binding_state.get("state") == "damaged" and (rec.get("venue") or "colab") == "colab":
        findings["binding-damaged"] = (
            f"CLI session-binding store damaged ({binding_state.get('detail') or 'unknown'}, "
            f"since {binding_state.get('at') or 'unknown'}) — session readings are "
            "unreliable until the funnel's heal restores it")
    findings.update(venue_state_findings(now, rec))

    speak = []
    for code, detail in findings.items():
        if code == "approval-outstanding":
            if episode and not episodes.get(episode, {}).get("escalated"):
                speak.append((code, detail))
                episodes[episode] = {"escalated": True, "at": now.isoformat()}
        elif code not in prev_open:
            speak.append((code, detail))
    if not findings and prev_open:
        speak.append(("cleared", "all findings resolved"))
    # An episode ends when its finding does; forget it so a
    # later blockage on the same host escalates afresh.
    if episode is None:
        episodes = {k: v for k, v in episodes.items() if not k.startswith(f"{rec.get('host')}|")}

    open_now = {}
    for code, detail in findings.items():
        open_now[code] = {"since": (prev_open.get(code) or {}).get("since") or now.isoformat(), "detail": detail}
    state.update({
        "session": session,
        "caller": rec.get("caller"),
        "host": rec.get("host"),
        "updated_at": now.isoformat(),
        "open": open_now,
        "approval_episodes": episodes,
        "work": work_facts(session),
    })
    state_path.parent.mkdir(parents=True, exist_ok=True)
    writer.staged_write(str(state_path), json.dumps(state, indent=1).encode())

    for code, detail in speak:
        print(f"LIVENESS {session} {code} {detail}")
    return 3 if speak else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
