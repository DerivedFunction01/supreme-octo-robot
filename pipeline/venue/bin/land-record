#!/usr/bin/env python3
"""Write a landing record at the moment a change lands.

Usage: land-record --sha SHA --gate-run RUN_ID [--gate-run RUN_ID ...]
                   [--formation-at ISO] [--change LABEL]
       land-record --sha SHA --no-gate [--formation-at ISO]

The record prices the landing per phase from data the
landing act already touches: formation opened (the
earliest gate run's started_at, or --formation-at when
the formation predates its first fire), gate-green (the
verdict run's finished_at — the last gate run that
completed with exit 0), and landed (this invocation).
Gate fires and their venue-minutes are counted onto the
record, and a union fire's constituents (the run
record's `constituents` list, when the dispatch stamps
one) count as the changes the landing carries.

Records land in results/landings/ beside results/runs/;
the supervision measure reads them back as the
gates-per-landing and phase-wall-clock rows. A landing
with gate runs but no green verdict run is refused:
the record is written for a landed, gated change, and
a red or never-ran gate is a different fact.

Paths and date handling ride their homes: the paths
spine (paths.py at the package root) owns the results
derivation, and the lease core foundation owns the
stamp parsing and epoch arithmetic — both bound by
path, the bootstrap form the bin tools use.
"""

from __future__ import annotations

import argparse
import importlib.util as _ilu
import json
import sys
from pathlib import Path


def _load(name: str, path: Path):
    spec = _ilu.spec_from_file_location(name, path)
    module = _ilu.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


_PATHS = _load(
    "venue_paths", Path(__file__).resolve().parent.parent / "paths.py"
)
_FOUNDATION = _load("venue_lease_foundation", _PATHS.LEASE_FOUNDATION)


def _minutes(start_epoch: float | None, end_epoch: float | None) -> float | None:
    if start_epoch is None or end_epoch is None:
        return None
    return round((end_epoch - start_epoch) / 60, 1)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="land-record")
    parser.add_argument("--sha", required=True)
    parser.add_argument("--gate-run", action="append", default=[])
    parser.add_argument("--no-gate", action="store_true")
    parser.add_argument("--formation-at")
    parser.add_argument("--change")
    parser.add_argument("--results-dir", type=Path)
    parser.add_argument("--now")
    args = parser.parse_args(argv)

    if args.no_gate and args.gate_run:
        print("land-record: --no-gate with --gate-run names both", file=sys.stderr)
        return 2
    if not args.no_gate and not args.gate_run:
        print(
            "land-record: name the gate run(s) the landing rode, or --no-gate",
            file=sys.stderr,
        )
        return 2

    runs_dir = args.results_dir / "runs" if args.results_dir else _PATHS.RUNS_DIR
    epoch = _FOUNDATION.epoch

    if args.now:
        landed_at = _FOUNDATION.iso_utc(_FOUNDATION.parse_dt(args.now))
    else:
        landed_at = _FOUNDATION.stamp()
    landed_epoch = epoch(landed_at)

    runs = []
    for run_id in args.gate_run:
        path = runs_dir / f"{run_id}.json"
        if not path.is_file():
            print(f"land-record: no run record {run_id}", file=sys.stderr)
            return 2
        runs.append(json.loads(path.read_text(encoding="utf-8")))

    verdict = None
    for record in runs:
        if record.get("state") == "complete" and record.get("exit_code") == 0:
            verdict = record
    gate_green_at = verdict.get("finished_at") if verdict else None
    if runs and gate_green_at is None:
        print(
            "land-record: no gate run completed green — a landing record "
            "is written for a landed, gated change",
            file=sys.stderr,
        )
        return 2

    formation_opened = args.formation_at
    if formation_opened is None and runs:
        starts = [
            (epoch(record.get("started_at")), record.get("started_at"))
            for record in runs
        ]
        starts = [pair for pair in starts if pair[0] is not None]
        if starts:
            formation_opened = min(starts)[1]
    if formation_opened is None:
        formation_opened = landed_at
    formation_epoch = epoch(formation_opened)
    gate_epoch = epoch(gate_green_at)

    venue_minutes = 0.0
    for record in runs:
        span = _minutes(
            epoch(record.get("started_at")), epoch(record.get("finished_at"))
        )
        if span is not None:
            venue_minutes += span

    constituents = sum(
        len(record["constituents"])
        for record in runs
        if isinstance(record.get("constituents"), list)
    )

    record = {
        "landed_sha": args.sha,
        "change": args.change,
        "landed_at": landed_at,
        "formation_opened_at": formation_opened,
        "gate_green_at": gate_green_at,
        "gate_runs": list(args.gate_run),
        "fires": len(runs),
        "venue_minutes": round(venue_minutes, 1),
        "constituent_count": constituents if constituents else 1,
        "phases_minutes": {
            "formation_to_gate": _minutes(formation_epoch, gate_epoch),
            "gate_to_landed": _minutes(gate_epoch, landed_epoch),
            "formation_to_landed": _minutes(formation_epoch, landed_epoch),
        },
    }

    out_dir = runs_dir.parent / "landings"
    out_dir.mkdir(parents=True, exist_ok=True)
    stamp = landed_at.replace(":", "").replace("-", "")[:15]
    out = out_dir / f"{args.sha[:12]}-{stamp}.json"
    out.write_text(json.dumps(record, indent=1) + "\n", encoding="utf-8")
    phases = record["phases_minutes"]
    print(
        f"landing record: {out} — fires {record['fires']}, "
        f"venue-minutes {record['venue_minutes']}, "
        f"formation→gate {phases['formation_to_gate']}m, "
        f"gate→landed {phases['gate_to_landed']}m"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
