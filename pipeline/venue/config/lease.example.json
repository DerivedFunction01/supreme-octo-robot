{
  "accounts": {
    "colab": [
      {
        "id": "primary",
        "label": "Primary account"
      },
      {
        "id": "backup",
        "label": "Second account (example)",
        "token_file": "var/backup-account.token"
      }
    ]
  },
  "auto_acquire": {
    "enabled": true
  },
  "budgets": {
    "colab": {
      "primary": {
        "daily": 10,
        "monthly": 100,
        "standing_daily": 4
      },
      "backup": {
        "daily": null,
        "monthly": null,
        "standing_daily": null
      }
    }
  },
  "default_shape": "cpu-highram",
  "enabled": true,
  "extend_guard": {
    "callers": {},
    "default_mode": "active-or-first",
    "enabled": true,
    "idle_after_minutes": 60,
    "max_extended_per_shape": 1,
    "shapes": {
      "a100-highram": "active-only"
    },
    "threshold_minutes": 120,
    "window_hours": 8
  },
  "idle_shutdown_minutes": null,
  "keepalive": {
    "enabled": true,
    "interval_seconds": 60,
    "pulse_seconds": 600,
    "stale_seconds": 600
  },
  "max_hours": 8,
  "rate_cu_per_hour": {
    "high_mem": 0.26,
    "standard": 0.08
  },
  "session_gate": {
    "agent_classes": [
      "high_ram"
    ],
    "bypass_actors": [
      "panel",
      "test"
    ],
    "enabled": true,
    "infra_actor": "standing"
  },
  "standing": {
    "caller": "standing",
    "max_session_hours": 12,
    "shape": "cpu",
    "warm_on_renew": true
  },
  "venue_targets": {
    "local": {
      "machine-a": {
        "host": "localhost",
        "port": 2222,
        "user": "agent",
        "session": "local-a",
        "start": ["/path/to/transport-forwarder", "<machine-address>", "22"]
      },
      "machine-b": {
        "host": "localhost",
        "port": 2223,
        "user": "agent",
        "session": "local-b"
      }
    }
  },
  "venue_shapes": {
    "local": [
      {
        "id": "local-a",
        "label": "Local machine A",
        "target": "machine-a",
        "cores": 8,
        "memory_gb": 16
      },
      {
        "id": "local-b",
        "label": "Local machine B",
        "target": "machine-b",
        "cores": 8,
        "memory_gb": 16
      }
    ]
  },
  "sync_claim": {
    "attach_window_minutes": 15,
    "max_sync_seconds": 300,
    "ttl_minutes": 60
  }
}