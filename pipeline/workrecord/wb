def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except reg.RegistryError as e:
        print(f"wb: refused: {e}", file=sys.stderr)
        return 2
    except kit_mod.KitError as e:
        print(f"wb: refused: {e}", file=sys.stderr)
        return 2
    except bundle_mod.BundleError as e:
        print(f"wb: refused: {e}", file=sys.stderr)
        return 2
    except active_mod.ActiveError as e:
        print(f"wb: refused: {e}", file=sys.stderr)
        return 2
    except files_mod.FileError_ as e:
        print(f"wb: refused: {e}", file=sys.stderr)
        return 2
    except goals_mod.GoalError as e:
        print(f"wb: refused: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
